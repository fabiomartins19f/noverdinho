# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Service role: NUNCA exponha no app — só este servidor usa.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# OpenAI (parser das mensagens do WhatsApp)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN=um-token-aleatorio-que-voce-inventar
WHATSAPP_APP_SECRET=app-secret-do-painel-da-meta
WHATSAPP_TOKEN=token-de-acesso-de-longa-duracao
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-no-painel-meta

# Open Finance via Pluggy (pluggy.ai)
PLUGGY_CLIENT_ID=seu-client-id
PLUGGY_CLIENT_SECRET=seu-client-secret
PLUGGY_WEBHOOK_SECRET=segredo-do-webhook-pluggy

PUBLIC_BASE_URL=https://seu-backend.com
PORT=3000
