// No Verdinho — Prisma Schema (PostgreSQL)
// Valores monetários SEMPRE Decimal(12,2). Nunca Float.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  DIGITAL
  INVESTMENT
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum DebtType {
  CREDIT_CARD
  LOAN
  FINANCING
  INSTALLMENT
  PERSONAL
  RENEGOTIATED
  OTHER
}

enum DebtStatus {
  ACTIVE
  OVERDUE
  NEGOTIATED
  PAID_OFF
  CANCELED
}

enum DebtPriority {
  HIGH
  MEDIUM
  LOW
}

enum InterestType {
  MONTHLY
  ANNUAL
  FIXED
}

enum PlanStrategy {
  AVALANCHE
  SNOWBALL
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum InsightType {
  SPENDING_INCREASE
  SPENDING_DECREASE
  INCOME_COMMITMENT
  CARD_LIMIT
  HIGH_INTEREST_DEBT
  BUDGET_OVERRUN
  BUDGET_GOOD
  POSITIVE_EVOLUTION
  PAYOFF_OPPORTUNITY
}

enum NotificationType {
  DUE_SOON
  OVERDUE
  INVOICE_DUE
  CARD_LIMIT
  BUDGET_OVERRUN
  DEBT_OVERDUE
  GOAL_REACHED
  PROGRESS
  PAYOFF_OPPORTUNITY
  SYSTEM
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  REGISTER
  CREATE
  UPDATE
  DELETE
  PAYMENT
  EXPORT
  SETTINGS_CHANGE
}

// ---------- Models ----------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  currency     String     @default("BRL")
  timezone     String     @default("America/Sao_Paulo")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions       Session[]
  passwordResets PasswordResetToken[]
  accounts       Account[]
  transactions   Transaction[]
  categories     Category[]
  cards          CreditCard[]
  invoices       CreditCardInvoice[]
  purchases      CreditCardPurchase[]
  installments   CreditCardInstallment[]
  debts          Debt[]
  debtInstallments DebtInstallment[]
  debtPayments   DebtPayment[]
  payoffPlans    DebtPayoffPlan[]
  budgets        Budget[]
  goals          Goal[]
  insights       FinancialInsight[]
  notifications  Notification[]
  pushDevices    PushDevice[]
  auditLogs      AuditLog[]

  @@index([status])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  name          String
  type          AccountType @default(CHECKING)
  initialBalance Decimal   @default(0) @db.Decimal(12, 2)
  currentBalance Decimal   @default(0) @db.Decimal(12, 2)
  institution   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, isActive])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @db.Uuid // null = categoria padrão do sistema
  name      String
  icon      String?
  color     String?
  kind      CategoryKind @default(EXPENSE)
  isDefault Boolean      @default(false)
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  purchases    CreditCardPurchase[]

  @@index([userId])
}

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  accountId        String            @db.Uuid
  transferAccountId String?          @db.Uuid
  categoryId       String?           @db.Uuid
  type             TransactionType
  amount           Decimal           @db.Decimal(12, 2)
  description      String
  transactionDate  DateTime          @default(now())
  status           TransactionStatus @default(CONFIRMED)
  recurring        Boolean           @default(false)
  recurrenceRule   String?
  idempotencyKey   String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, transactionDate])
  @@index([userId, accountId])
  @@index([userId, type, transactionDate])
}

model CreditCard {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  institution String?
  limit       Decimal  @db.Decimal(12, 2)
  closingDay  Int      @default(1)
  dueDay      Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices    CreditCardInvoice[]
  purchases   CreditCardPurchase[]
  installments CreditCardInstallment[]

  @@index([userId])
}

model CreditCardInvoice {
  id            String        @id @default(uuid()) @db.Uuid
  cardId        String        @db.Uuid
  userId        String        @db.Uuid
  referenceMonth Int
  referenceYear  Int
  closingDate   DateTime
  dueDate       DateTime
  amount        Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(OPEN)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  card         CreditCard       @relation(fields: [cardId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments CreditCardInstallment[]

  @@unique([cardId, referenceMonth, referenceYear])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model CreditCardPurchase {
  id            String    @id @default(uuid()) @db.Uuid
  cardId        String    @db.Uuid
  userId        String    @db.Uuid
  categoryId    String?
  description   String
  amount        Decimal   @db.Decimal(12, 2) // valor total da compra
  purchaseDate  DateTime  @default(now())
  installmentCount Int       @default(1)
  createdAt     DateTime  @default(now())

  card         CreditCard         @relation(fields: [cardId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?          @relation(fields: [categoryId], references: [id])
  installments CreditCardInstallment[]

  @@index([userId, purchaseDate])
}

model CreditCardInstallment {
  id          String            @id @default(uuid()) @db.Uuid
  purchaseId  String            @db.Uuid
  cardId      String            @db.Uuid
  userId      String            @db.Uuid
  invoiceId   String?           @db.Uuid
  number      Int
  amount      Decimal           @db.Decimal(12, 2)
  dueDate     DateTime
  status      InstallmentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  purchase CreditCardPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  card     CreditCard          @relation(fields: [cardId], references: [id])
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice  CreditCardInvoice?  @relation(fields: [invoiceId], references: [id])

  @@index([userId, dueDate])
  @@index([invoiceId])
  @@index([cardId, status])
}

model Debt {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @db.Uuid
  creditor           String
  type               DebtType
  originalAmount     Decimal     @db.Decimal(12, 2)
  currentBalance     Decimal     @db.Decimal(12, 2)
  interestRate       Decimal     @default(0) @db.Decimal(6, 2) // percentual
  interestType       InterestType @default(ANNUAL)
  penaltyRate        Decimal     @default(0) @db.Decimal(6, 2)
  installmentAmount  Decimal?    @db.Decimal(12, 2)
  totalInstallments  Int?
  paidInstallments   Int         @default(0)
  dueDate            DateTime
  status             DebtStatus  @default(ACTIVE)
  priority           DebtPriority @default(MEDIUM)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments DebtInstallment[]
  payments     DebtPayment[]
  planItems    DebtPayoffPlanItem[]

  @@index([userId, status])
  @@index([userId, dueDate])
}

model DebtInstallment {
  id               String            @id @default(uuid()) @db.Uuid
  debtId           String            @db.Uuid
  userId           String            @db.Uuid
  installmentNumber Int
  dueDate          DateTime
  principalAmount  Decimal           @default(0) @db.Decimal(12, 2)
  interestAmount   Decimal           @default(0) @db.Decimal(12, 2)
  penaltyAmount    Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(12, 2)
  status           InstallmentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime          @default(now())

  debt   Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([debtId, status])
  @@index([userId, dueDate])
}

model DebtPayment {
  id             String          @id @default(uuid()) @db.Uuid
  debtId         String          @db.Uuid
  installmentId  String?         @db.Uuid
  userId         String          @db.Uuid
  amount         Decimal         @db.Decimal(12, 2)
  paymentDate    DateTime        @default(now())
  note           String?
  createdAt      DateTime        @default(now())

  debt         Debt             @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installment  DebtInstallment? @relation(fields: [installmentId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debtId, paymentDate])
  @@index([userId, paymentDate])
}

model DebtPayoffPlan {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  strategy          PlanStrategy
  monthlyBudget     Decimal       @db.Decimal(12, 2)
  estimatedMonths   Int
  estimatedInterest Decimal       @db.Decimal(12, 2)
  estimatedTotal    Decimal       @db.Decimal(12, 2)
  baselineInterest  Decimal?      @db.Decimal(12, 2)
  projectedPayoffDate DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DebtPayoffPlanItem[]

  @@index([userId])
}

model DebtPayoffPlanItem {
  id               String     @id @default(uuid()) @db.Uuid
  planId           String     @db.Uuid
  debtId           String     @db.Uuid
  order            Int
  payoffMonth      Int
  projectedPayoffDate DateTime
  amountPerMonth   Decimal    @db.Decimal(12, 2)

  plan DebtPayoffPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  debt Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([planId, order])
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  month      Int
  year       Int
  totalLimit Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, month, year])
  @@index([userId])
}

model BudgetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  budgetId  String   @db.Uuid
  categoryId String? @db.Uuid
  name      String
  limit     Decimal  @db.Decimal(12, 2)
  spent     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Goal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  name          String
  emoji         String?
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  priority      DebtPriority @default(MEDIUM)
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FinancialInsight {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        InsightType
  title       String
  description String
  action      String?
  importance  DebtPriority @default(MEDIUM)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model PushDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  token        String   @unique
  platform     String   @default("ios")
  apnsTopic    String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  action    AuditAction
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
