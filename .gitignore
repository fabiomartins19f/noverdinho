# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Native iOS (builds e derived data — o .xcodeproj é gerado por xcodegen)
ios/build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
backend/.env

# typescript
*.tsbuildinfo

# logs
*.log
# Xcode (user data local)
xcuserdata/
*.xcuserstate
